{
  "name": "nuxt-kirby",
  "type": "module",
  "version": "4.1.1",
  "packageManager": "pnpm@12.18.0",
  "description": "Kirby CMS data in Nuxt, via KQL or the REST API",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://nuxt-kirby.byjohann.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/nuxt-kirby.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/nuxt-kirby/issues"
  },
  "keywords": [
    "kirby",
    "kirby-cms",
    "getkirby",
    "nuxt",
    "kql"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && nuxt prepare test/fixture",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "bumpp"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7",
    "destr": "^2.0.5",
    "h3": "^1.15.11",
    "kirby-types": "^1.8.2",
    "ofetch": "^1.5.1",
    "ohash": "^2.0.12",
    "pathe": "^2.0.3",
    "scule": "^1.3.0",
    "ufo": "^1.6.4",
    "uint8array-extras": "^1.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.4",
    "playwright-core": "^1.65.0",
    "srvx": "^1.0.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
